// 41. Pointers - swap two numbers
#include <stdio.h>
void swap(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}
int main() {
    int x, y; scanf("%d%d",&x,&y);
    swap(&x,&y);
    printf("After Swap: %d %d", x, y);
    return 0;
}

// 42. Pointer arithmetic (array access)
#include <stdio.h>
int main() {
    int a[5] = {10,20,30,40,50};
    int *p = a;
    for(int i=0;i<5;i++)
        printf("%d ", *(p+i));
    return 0;
}

// 43. Dynamic memory allocation (malloc)
#include <stdio.h>
#include <stdlib.h>
int main() {
    int n; scanf("%d",&n);
    int arr = (int)malloc(n*sizeof(int));
    for(int i=0;i<n;i++) scanf("%d",&arr[i]);
    for(int i=0;i<n;i++) printf("%d ", arr[i]);
    free(arr);
    return 0;
}

// 44. Dynamic memory allocation (calloc)
#include <stdio.h>
#include <stdlib.h>
int main() {
    int n; scanf("%d",&n);
    int arr = (int)calloc(n,sizeof(int));
    for(int i=0;i<n;i++) scanf("%d",&arr[i]);
    for(int i=0;i<n;i++) printf("%d ", arr[i]);
    free(arr);
    return 0;
}

