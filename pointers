// 52. Pointer to structure
#include <stdio.h>
struct Student {
    int roll;
    char name[50];
    float marks;
};
int main() {
    struct Student s;
    struct Student *p = &s;
    scanf("%d %s %f",&p->roll, p->name, &p->marks);
    printf("Roll:%d Name:%s Marks:%.2f", p->roll, p->name, p->marks);
    return 0;
}

// 48. Reverse a string using pointer
#include <stdio.h>
#include <string.h>
int main() {
    char str[100]; scanf("%s", str);
    char *p=str, *q=str+strlen(str)-1;
    while(p<q) {
        char temp=*p; *p=*q; *q=temp;
        p++; q--;
    }
    printf("Reverse = %s", str);
    return 0;
}

// 49. Find largest element using pointer
#include <stdio.h>
int main() {
    int n; scanf("%d",&n);
    int a[n]; for(int i=0;i<n;i++) scanf("%d",&a[i]);
    int *p=a, max=*p;
    for(int i=1;i<n;i++) if((p+i)>max) max=(p+i);
    printf("Max = %d", max);
    return 0;
}
