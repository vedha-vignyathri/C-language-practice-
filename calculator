// 54. Simple calculator using switch
#include <stdio.h>
int main() {
    int a, b, choice;
    scanf("%d%d%d",&a,&b,&choice);
    switch(choice) {
        case 1: printf("Sum = %d", a+b); break;
        case 2: printf("Difference = %d", a-b); break;
        case 3: printf("Product = %d", a*b); break;
        case 4: 
            if(b!=0) printf("Division = %.2f", (float)a/b);
            else printf("Division by zero!"); 
            break;
        default: printf("Invalid Choice");
    }
    return 0;
}


