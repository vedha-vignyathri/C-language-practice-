// 54. Simple calculator using switch
#include <stdio.h>
int main() {
    int a, b, choice;
    scanf("%d%d%d",&a,&b,&choice);
    switch(choice) {
        case 1: printf("Sum = %d", a+b); break;
        case 2: printf("Difference = %d", a-b); break;
        case 3: printf("Product = %d", a*b); break;
        case 4: 
            if(b!=0) printf("Division = %.2f", (float)a/b);
            else printf("Division by zero!"); 
            break;
        default: printf("Invalid Choice");
    }
    return 0;
}

OR

#include <stdio.h>
#include <string.h>

struct Student {
    int roll;
    char name[50];
    float marks;
};

int main() {
    struct Student students[100];
    int n = 0, choice, i, rollNo, found;

    do {
        printf("\n--- Student Management ---\n");
        printf("1. Add Student\n");
        printf("2. Display Students\n");
        printf("3. Search Student\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch(choice) {
            case 1:
                printf("Enter Roll Number: ");
                scanf("%d", &students[n].roll);
                printf("Enter Name: ");
                scanf(" %[^\n]", students[n].name);
                printf("Enter Marks: ");
                scanf("%f", &students[n].marks);
                n++;
                break;

            case 2:
                printf("\n--- Student List ---\n");
                for(i = 0; i < n; i++) {
                    printf("Roll: %d, Name: %s, Marks: %.2f\n", students[i].roll, students[i].name, students[i].marks);
                }
                break;

            case 3:
                printf("Enter Roll Number to Search: ");
                scanf("%d", &rollNo);
                found = 0;
                for(i = 0; i < n; i++) {
                    if(students[i].roll == rollNo) {
                        printf("Roll: %d, Name: %s, Marks: %.2f\n", students[i].roll, students[i].name, students[i].marks);
                        found = 1;
                        break;
                    }
                }
                if(!found) {
                    printf("Student Not Found!\n");
                }
                break;

            case 4:
                printf("Exiting Program...\n");
                break;

            default:
                printf("Invalid Choice!\n");
        }
    } while(choice != 4);

    return 0;
}
