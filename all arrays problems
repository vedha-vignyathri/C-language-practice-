}

// 23. Sort array (ascending)
#include <stdio.h>
int main() {
    int n, arr[100], temp;
    scanf("%d", &n);
    for(int i=0;i<n;i++) scanf("%d",&arr[i]);
    for(int i=0;i<n-1;i++) {
        for(int j=i+1;j<n;j++) {
            if(arr[i]>arr[j]) {
                temp=arr[i]; arr[i]=arr[j]; arr[j]=temp;
            }
        }
    }
    for(int i=0;i<n;i++) printf("%d ", arr[i]);
    return 0;
}

// 24. Linear search
#include <stdio.h>
int main() {
    int n, arr[100], key, found=0;
    scanf("%d", &n);
    for(int i=0;i<n;i++) scanf("%d",&arr[i]);
    scanf("%d", &key);
    for(int i=0;i<n;i++) if(arr[i]==key) { found=1; break; }
    if(found) printf("Found");
    else printf("Not Found");
    return 0;
}

// 25. Binary search
#include <stdio.h>
int main() {
    int n, arr[100], key, low=0, high, mid, found=0;
    scanf("%d", &n);
    for(int i=0;i<n;i++) scanf("%d",&arr[i]);
    scanf("%d", &key);
    high=n-1;
    while(low<=high) {
        mid=(low+high)/2;
        if(arr[mid]==key) { found=1; break; }
        else if(arr[mid]<key) low=mid+1;
        else high=mid-1;
    }
    if(found) printf("Found");
    else printf("Not Found");
    return 0;
}

// 26. Matrix addition
#include <stdio.h>
int main() {
    int a[10][10], b[10][10], sum[10][10], n, m;
    scanf("%d%d", &n, &m);
    for(int i=0;i<n;i++) for(int j=0;j<m;j++) scanf("%d",&a[i][j]);
    for(int i=0;i<n;i++) for(int j=0;j<m;j++) scanf("%d",&b[i][j]);
    for(int i=0;i<n;i++) {
        for(int j=0;j<m;j++) {
            sum[i][j]=a[i][j]+b[i][j];
            printf("%d ", sum[i][j]);
        }
        printf("\n");
    }
    return 0;
}

// 27. Matrix multiplication
#include <stdio.h>
int main() {
    int a[10][10], b[10][10], c[10][10]={0}, n, m, p, q;
    scanf("%d%d", &n, &m);
    for(int i=0;i<n;i++) for(int j=0;j<m;j++) scanf("%d",&a[i][j]);
    scanf("%d%d", &p, &q);
    for(int i=0;i<p;i++) for(int j=0;j<q;j++) scanf("%d",&b[i][j]);
    if(m!=p) { printf("Not Possible"); return 0; }
    for(int i=0;i<n;i++) {
        for(int j=0;j<q;j++) {
            for(int k=0;k<m;k++) c[i][j]+=a[i][k]*b[k][j];
            printf("%d ", c[i][j]);
        }
        printf("\n");
    }
    return 0;
}



